# Firebase Client SDK (safe to expose — used in browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server only — never expose to client)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenAI (server only) — AI challenge generation + journal reflections
OPENAI_API_KEY=

# Email (server only) — Gmail SMTP transport + notifications
# GMAIL_APP_PASSWORD is a Google Account App Password (requires 2-Step
# Verification), not the account's login password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
