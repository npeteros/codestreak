# MySQL (server only)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Session signing key (server only) — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenAI (server only) — AI challenge generation + journal reflections
OPENAI_API_KEY=

# Email (server only) — Gmail SMTP transport + notifications
# GMAIL_APP_PASSWORD is a Google Account App Password (requires 2-Step
# Verification), not the account's login password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
