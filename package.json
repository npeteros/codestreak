{
  "name": "codestreak",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "unseed": "tsx --env-file=.env scripts/unseed.ts",
    "db:sync": "bun run scripts/db/sync.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "email:dev": "email dev --dir emails",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:status": "sequelize-cli db:migrate:status"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "html-to-image": "^1.11.13",
    "jose": "^6.1.0",
    "lucide-react": "^1.21.0",
    "mysql2": "^3.15.3",
    "next": "16.2.9",
    "nodemailer": "^9.0.3",
    "openai": "^6.45.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-email": "^6.9.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "@react-email/ui": "^6.9.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "sequelize-cli": "^6.6.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
